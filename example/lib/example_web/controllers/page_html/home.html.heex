<Layouts.app flash={@flash} locale={@locale} width={:wide}>
  <section class="flex flex-col gap-4">
    <span class="badge badge-primary badge-soft w-fit">elementorex_cms {@version} · path: ".."</span>
    <h1 class="text-4xl font-black tracking-tight sm:text-5xl">
      <span class="text-primary">ElementorexCms</span> test bench
    </h1>
    <p class="max-w-2xl text-lg opacity-70">
      This app uses the library one folder up as a path dependency: any change in
      <code>../lib</code>
      is recompiled and reloaded here.
    </p>
  </section>

  <section class="mt-10 grid gap-4 md:grid-cols-3">
    <.feature_card
      id="home-pages"
      href={~p"/admin/pages"}
      icon="hero-document-text"
      title="Pages CMS"
      text="Generated with mix elementorex.gen.cms: list, full screen editor with image uploads and a public page."
    />
    <.feature_card
      id="home-showcase"
      href={~p"/p/every-block"}
      icon="hero-squares-2x2"
      title="Every block"
      text="The 34 built-in blocks plus Pricing, WhatsApp and Callout, with responsive and hover styles, animations and custom CSS."
    />
    <.feature_card
      id="home-playground"
      href={~p"/playground"}
      icon="hero-beaker"
      title="Playground"
      text="Embedded editor for a modal: fewer blocks, its own frame on the canvas and a live preview."
    />
  </section>

  <section class="mt-12 grid gap-8 lg:grid-cols-2">
    <div class="flex flex-col gap-3">
      <h2 class="text-sm font-semibold uppercase tracking-wide opacity-60">Pages</h2>
      <ul id="home-page-list" class="divide-y divide-base-300 rounded-box border border-base-300">
        <li :if={@pages == []} class="p-4 text-sm opacity-60">
          No pages yet: run <code>mix run priv/repo/seeds.exs</code>.
        </li>
        <li :for={page <- @pages} class="flex items-center gap-3 p-4">
          <div class="min-w-0 flex-1">
            <p class="font-medium">{page.title}</p>
            <p class="truncate text-sm opacity-60">
              {page.body |> ElementorexCms.to_text() |> String.slice(0, 90)}
            </p>
          </div>
          <span class={["badge badge-sm", page.status == :published && "badge-success badge-soft"]}>
            {page.status}
          </span>
          <.link navigate={~p"/admin/pages/#{page.id}/edit"} class="btn btn-sm btn-ghost">
            Edit
          </.link>
        </li>
      </ul>
    </div>

    <div class="flex flex-col gap-3">
      <h2 class="text-sm font-semibold uppercase tracking-wide opacity-60">
        Rendered by a controller
      </h2>
      <%!-- No LiveView here: app.js starts the countdown with initElementorex() --%>
      <div
        id="home-promo"
        data-exr-static
        class="rounded-box border border-base-300 bg-base-100 p-6 shadow-sm"
      >
        <ElementorexCms.Components.document
          document={@promo}
          data={Example.site_data()}
          locale={@locale}
        />
      </div>
    </div>
  </section>
</Layouts.app>
